# ==============================================================================
# QCF News — PRODUCTION environment
# ==============================================================================
#   cp .env.production.example .env.production
#   # replace every CHANGE_ME below, then:
#   make ENV=prod build && make ENV=prod migrate && make ENV=prod up
#
# The filled-in .env.production is a secret file.  It is gitignored; keep it out
# of images, backups and chat, and prefer your platform's secret store over a
# file on disk where one is available.
#
# The file is consumed twice: once by `docker compose --env-file` to expand
# ${...} inside the compose YAML, and once as `env_file` to populate the backend
# and frontend containers.
# ==============================================================================

# ── Identity ──────────────────────────────────────────────────────────────────
# Namespaces containers, networks and volumes, and keeps the production stack
# separate from a dev stack on the same host.
COMPOSE_PROJECT_NAME=qcf_news
PROJECT_NAME=qcf_news

# ── General ───────────────────────────────────────────────────────────────────
# NODE_ENV=production is load-bearing, not cosmetic: the BFF session routes set
# the `Secure` flag on admin cookies only when it is exactly this value.
NODE_ENV=production
DEBUG=False

# Interactive API docs publish a complete map of every route and payload.
# Off in production; the paths return 404.  Set True only for a deployment
# that is not publicly reachable.
ENABLE_API_DOCS=False

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
#
# Hex, not base64.  `src/config/settings.py` builds the database URL by string
# interpolation, so a password containing `/`, `+` or `@` — which base64 produces
# about half the time — ends the authority section early and the connection fails
# or silently resolves somewhere else.  Hex has none of those characters.
POSTGRES_USER=qcf_news
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=qcf_news

# Overridden to db:5432 inside the compose network; these values only apply to
# tooling run outside Docker against the same database.
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=128mb

# ── Published host ports ──────────────────────────────────────────────────────
# nginx is NOT part of this stack.  It runs on the host, reads your own
# /home/conf/qcfnews.conf, and proxies to the two ports below.  Both are bound
# to 127.0.0.1 by docker-compose.prod.yml, so only the host reaches them.
#
# Change these only to avoid a collision with something already on the host —
# and change /home/conf/qcfnews.conf to match, or nginx proxies into a closed
# port and every request is a 502.
FRONTEND_PUBLISHED_PORT=3000
BACKEND_PUBLISHED_PORT=8000

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
APP_NAME=qcf_news
# Mirrors of the POSTGRES_* values above, for the backend's Settings class.
DB_NAME=qcf_news
DB_USER=qcf_news
DB_PASS=CHANGE_ME_to_a_strong_password

# JWT — two DIFFERENT keys.  Generate each with: openssl rand -hex 64
# Rotating either one invalidates every issued token of that kind.
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET_KEY=CHANGE_ME_generate_a_different_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Media / uploads ───────────────────────────────────────────────────────────
MEDIA_URL=/media
# Leave empty so uploads are stored as *relative* paths (/media/2026/08/x.jpg).
# The host nginx serves /media from the same origin as the site, so a relative
# path is correct for the browser, for next/image, and for any future move to a
# CDN.  Setting a host here bakes that host into the database and breaks all
# three — and the rows outlive the deployment that wrote them.
PUBLIC_BASE_URL=
# CAUTION: these multiply.  20 × 10 MB is a 200 MB multipart request, and
# Cloudflare rejects request bodies over 100 MB on Free/Pro/Business — with a
# 413 at the edge that never reaches nginx or FastAPI, so nothing appears in
# any log you control and it looks like a bug in the upload code.
# Keep MAX_IMAGE_SIZE_MB × MAX_IMAGES_PER_UPLOAD under 100.
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_UPLOAD=9
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp,avif

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60
# True because the host nginx sets X-Forwarded-For itself.  THREE conditions
# make that safe, and all three are required:
#
#   1. The API port is published on 127.0.0.1 only (docker-compose.prod.yml),
#      so nothing off-host can reach the backend without passing through nginx.
#   2. nginx sets `X-Forwarded-For $remote_addr` and NOT
#      `$proxy_add_x_forwarded_for`.  The backend trusts the left-most entry,
#      and the latter puts the client's own header in front of it — which hands
#      every caller a fresh rate-limit identity per request.
#   3. nginx restores the real visitor address first, with `set_real_ip_from`
#      over Cloudflare's ranges plus `real_ip_header CF-Connecting-IP`.  Behind
#      the proxy every request arrives from a Cloudflare edge IP, so without
#      this the rules below apply to ~15 addresses shared by the whole
#      internet — five failed logins anywhere would lock out every reader.
#
# All three live in nginx/qcfnews.conf.example.  Set this False if you cannot
# guarantee them.
RATE_LIMIT_TRUST_PROXY=True
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json
RATE_LIMIT_RULES=POST /api/v1/users/login=5/60,POST /api/v1/users/token=5/60,POST /api/v1/users/register=5/60,POST /api/v1/users/refresh-token=5/60,POST /api/v1/users/change-password=5/60,/api/v1/uploads=5/60,POST /api/v1/newsletter/subscribe=5/300,POST /api/v1/newsletter/confirm=10/300,POST /api/v1/newsletter/unsubscribe=10/300

# Gunicorn workers.  Rule of thumb: (2 × CPU cores) + 1, then measure.
BACKEND_WORKERS=4

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origins allowed to make credentialed browser requests to the API.
# MUST be a real list, never `*`: a wildcard combined with credentials is both
# a browser-rejected and an unsafe policy.  In the default single-origin setup
# this is just your public site origin.
CORS_ALLOW_ORIGINS=https://CHANGE_ME.example.com

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Server-side only: how the Next container reaches the API.  A private Docker
# name is correct — it never reaches a browser and never builds a media URL.
API_INTERNAL_ORIGIN=http://backend:8000

# Public canonical origin: canonical URLs, sitemap, RSS feed, social cards.
# Next inlines this into the CLIENT BUNDLE at build time, so changing it
# requires `make ENV=prod build`, not just a restart.  With Cloudflare in front
# the site is https:// from the moment it is public, so this must ALREADY be the
# https:// origin in your first production build — otherwise every canonical
# URL, sitemap entry, RSS link and social card you publish says http://.
NEXT_PUBLIC_SITE_URL=https://CHANGE_ME.example.com

# Browser-facing base for uploaded media.  Leave empty for the default
# same-origin setup.  Set it only when media is served from a public CDN
# (e.g. https://cdn.example.com); the host is added to next/image's
# remotePatterns automatically.  It must never point at a private host:
# next/image refuses an upstream resolving to a private IP, and a browser
# cannot resolve one anyway.  Also inlined at build time.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Lets the *backend* call POST /api/revalidate directly (header:
# x-revalidation-secret) for mutations that don't originate in the admin UI.
# Server-side only; never exposed to the browser.  The admin UI needs no
# secret — it is authenticated by its HttpOnly session cookie.  Leaving this
# unset closes the machine-to-machine path: the endpoint fails closed.
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Admin session notes ───────────────────────────────────────────────────────
# Admin auth tokens live in Secure, HttpOnly, SameSite=Strict cookies set by the
# BFF session endpoints (/api/admin/session/*).  No JWT is ever exposed to
# client-side JavaScript.  Next.js middleware adds a strict Content-Security-
# Policy header on every response.

# ── Newsletter ────────────────────────────────────────────────────────────────
# Leave False to ship without a signup form — the component renders nothing and
# the API refuses signups, which is the correct state for a site with no mail
# provider yet.  Turning it on REQUIRES NEWSLETTER_FROM_EMAIL, SITE_BASE_URL,
# POSTAL_ADDRESS and SMTP_HOST: the backend validates them at startup and
# refuses to boot half-configured, because a half-configured signup form still
# looks like a working one to a reader.
#
# Everything the list needs is stored here, in this app's own database
# (`newsletter_subscribers`), including the consent evidence for each address:
# when it was submitted, from which form, from which IP, and when the
# confirmation link was clicked.
NEWSLETTER_ENABLED=False
# The envelope sender.  Use an address on a domain whose SPF, DKIM and DMARC
# records name your relay, or the confirmations land in spam.
NEWSLETTER_FROM_EMAIL=newsletter@CHANGE_ME.example.com
NEWSLETTER_FROM_NAME=Celeb Scoop
NEWSLETTER_REPLY_TO=
NEWSLETTER_CONFIRM_TOKEN_TTL_HOURS=48
NEWSLETTER_RESEND_INTERVAL_SECONDS=300
# Optional mailto: alternative in the List-Unsubscribe header.  Whatever you
# put here has to actually process opt-outs.
NEWSLETTER_UNSUBSCRIBE_MAILBOX=
# Key the permanent unsubscribe tokens are derived from.  Generate with:
#   openssl rand -hex 32
# Rotating it invalidates every unsubscribe link already in a reader's inbox,
# so treat it as write-once.  Left empty it falls back to JWT_SECRET_KEY, which
# then cannot be rotated without the same effect.
NEWSLETTER_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Public brand and origin, used to build the links inside emails.  Must be the
# origin readers browse — the same value as NEXT_PUBLIC_SITE_URL.
SITE_NAME=Celeb Scoop
SITE_BASE_URL=https://CHANGE_ME.example.com
# A real postal address, printed in the footer of every message.  CAN-SPAM
# §7704(a)(5) requires one; the backend will not start without it.
POSTAL_ADDRESS=CHANGE_ME, 1 Example Street, London, EC1A 1AA

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Your transactional relay — SES, Postmark, Mailgun, or your own submission
# server.  Certificates are verified, so the host must match the certificate.
SMTP_HOST=CHANGE_ME.smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# STARTTLS on 587.  For implicit TLS on 465, set SMTP_USE_SSL=True instead.
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=10

# Renders the signup form.  Next inlines this into the CLIENT BUNDLE at build
# time, so changing it needs `make ENV=prod build`, not a restart — and it must
# match NEWSLETTER_ENABLED above.  Set to `true` only together with it.
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# ── Google Integrations (SEO, Analytics & Ads) ─────────────────────────────────
# Google Search Console site verification meta tag content string
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense Publisher Client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

