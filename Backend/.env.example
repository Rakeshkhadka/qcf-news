# ==============================================================================
# Backend-only template — for running FastAPI directly in a virtualenv.
# The Docker stacks do NOT read this file; they use ../.env.development or
# ../.env.production. See the repository README under "Environments".
# ==============================================================================

# Application
APP_NAME=qcf_news
DEBUG=True

# Interactive API docs (/docs, /redoc, /openapi.json). Off unless asked for.
ENABLE_API_DOCS=True

# Exact origins allowed to make browser requests to this API, comma separated.
# Empty = same-origin only, which is the correct default behind a reverse
# proxy. Never set "*" together with credentialed requests: browsers reject
# that combination, so it disables credentials rather than loosening anything.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Database
DB_NAME=qcf_news
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# Alembic (auto-built from DB_* if not set)
# ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qcf_news

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_REFRESH_SECRET_KEY=change-me-to-a-different-random-secret-key

# Redis
REDIS_URL=redis://localhost:6379/0

# Media / uploads
# MEDIA_ROOT defaults to <Backend>/media
MEDIA_URL=/media
# Absolute origin used when building image URLs (leave empty for relative)
PUBLIC_BASE_URL=http://localhost:8000
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_UPLOAD=20
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp,avif

# Rate limiting (per client IP, backed by Redis)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60
# Set True only when a reverse proxy you control sets X-Forwarded-For
RATE_LIMIT_TRUST_PROXY=False
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json
# Tighter per-endpoint budgets, enforced on top of the global one.
# Format: "[METHOD ]PATH=LIMIT/WINDOW[/BLOCK]", comma separated. PATH is a
# prefix, so /api/v1/uploads covers every route beneath it.
RATE_LIMIT_RULES=POST /api/v1/users/login=5/60,POST /api/v1/users/token=5/60,POST /api/v1/users/register=5/60,POST /api/v1/users/refresh-token=5/60,POST /api/v1/users/change-password=5/60,/api/v1/uploads=5/60,POST /api/v1/newsletter/subscribe=5/300,POST /api/v1/newsletter/confirm=10/300,POST /api/v1/newsletter/unsubscribe=10/300

# ── Site identity ─────────────────────────────────────────────────────────────
# The public brand and origin, as a reader sees them. SITE_BASE_URL is the site
# the confirm and unsubscribe links are built on, so it must be absolute and
# must be the origin readers actually browse — not the API's own.
SITE_NAME=Celeb Scoop
SITE_BASE_URL=http://localhost:3000
# Printed in the footer of every email. CAN-SPAM requires a real postal address
# in commercial mail; the app refuses to start with the newsletter enabled and
# this empty.
POSTAL_ADDRESS=

# ── Newsletter ────────────────────────────────────────────────────────────────
# Off by default, and the signup form is not rendered while it is off. Turning
# it on requires NEWSLETTER_FROM_EMAIL, SITE_BASE_URL, POSTAL_ADDRESS and (out
# of DEBUG) SMTP_HOST — the app checks at startup rather than letting the form
# accept addresses it cannot mail.
NEWSLETTER_ENABLED=False
NEWSLETTER_FROM_EMAIL=
# Display name on outgoing mail; falls back to SITE_NAME.
NEWSLETTER_FROM_NAME=
NEWSLETTER_REPLY_TO=
# How long a confirmation link stays valid.
NEWSLETTER_CONFIRM_TOKEN_TTL_HOURS=48
# Minimum gap between two confirmation emails to the SAME address, so the form
# cannot be used to bomb somebody's inbox from a rotating set of IPs.
NEWSLETTER_RESEND_INTERVAL_SECONDS=300
# Optional second List-Unsubscribe method, for clients that prefer mailto:.
NEWSLETTER_UNSUBSCRIBE_MAILBOX=
# Key the permanent unsubscribe tokens are derived from. Falls back to
# JWT_SECRET_KEY, which works — but then rotating the JWT key also breaks every
# unsubscribe link already sitting in a reader's inbox. Generate with:
#   openssl rand -hex 32
NEWSLETTER_TOKEN_SECRET=

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Empty host = no delivery. In DEBUG the mailer logs messages instead (the
# confirmation URL appears in the log, which is enough to walk the flow
# locally); outside DEBUG an empty host with NEWSLETTER_ENABLED=True is a
# startup error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the submission port. SMTP_USE_SSL is implicit TLS (port 465) and
# wins when both are set. Certificates are verified either way.
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=10
