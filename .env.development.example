# ==============================================================================
# QCF News — DEVELOPMENT environment
# ==============================================================================
#   cp .env.development.example .env.development
#   make dev
#
# Unlike the production template, this file has no CHANGE_ME markers: every
# value below is a working local default and the secrets are deliberately weak
# and public.  That is the point — nothing here is worth protecting, and nothing
# here may ever be reused in production.
#
# The file is consumed twice: once by `docker compose --env-file` to expand
# ${...} inside the compose YAML, and once as `env_file` to populate the backend
# and frontend containers.
# ==============================================================================

# ── Identity ──────────────────────────────────────────────────────────────────
# Namespaces containers, networks and volumes.  Because it differs from the
# production project name, the dev and prod stacks can run side by side without
# sharing a database, a Redis, or a media volume.
COMPOSE_PROJECT_NAME=qcf_news_dev
PROJECT_NAME=qcf_news_dev

# ── General ───────────────────────────────────────────────────────────────────
# NODE_ENV drives more than logging: the BFF session routes set the `Secure`
# cookie flag only when it is `production`, which is exactly why admin login
# works here over plain http://localhost.
NODE_ENV=development
DEBUG=True

# Swagger UI at /docs, ReDoc at /redoc, schema at /openapi.json.
ENABLE_API_DOCS=True

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qcf_news

# Inside Docker the compose file overrides these to `db:5432`.  The values here
# are what host-side tooling uses — running alembic or manage.py in your own
# virtualenv against the container's published port.
DB_HOST=localhost
DB_PORT=5434

# ── Redis ─────────────────────────────────────────────────────────────────────
# Same story: overridden to redis://redis:6379/0 inside the compose network.
REDIS_URL=redis://localhost:6382/0
REDIS_MAXMEMORY=64mb

# ── Published host ports ──────────────────────────────────────────────────────
# There is no proxy locally, so the Next server on 3000 IS the front door.  The
# rest are published so you can attach psql, redis-cli or an HTTP client
# directly.  The Postgres and Redis numbers avoid the defaults on purpose, so a
# locally installed copy of either can keep running.
FRONTEND_PUBLISHED_PORT=3000
BACKEND_PUBLISHED_PORT=8000
DB_PUBLISHED_PORT=5434
REDIS_PUBLISHED_PORT=6382

# ── File watching ─────────────────────────────────────────────────────────────
# On Linux, inotify events cross the bind mount and hot reload just works.
# On Docker Desktop (macOS / Windows) they are not reliably delivered and HMR
# goes quiet with no error — uncomment this there. It costs CPU, so leave it
# off otherwise.
# WATCHPACK_POLLING=true

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
APP_NAME=qcf_news
DB_NAME=qcf_news
DB_USER=postgres
DB_PASS=postgres

# Local-only signing keys.  Rotating them just invalidates your own sessions.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-do-not-use-in-production
JWT_REFRESH_SECRET_KEY=dev-only-insecure-refresh-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Media / uploads ───────────────────────────────────────────────────────────
MEDIA_URL=/media
# Empty, so uploads are stored as relative paths (/media/2026/08/photo.jpg) —
# the same as production.  Setting a host here bakes it into the database rows
# and those rows outlive the environment that created them.
PUBLIC_BASE_URL=
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_UPLOAD=20
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp,avif

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Off by default: the per-endpoint rules cap logins at 5/minute, which locks you
# out of your own admin panel within a minute of testing it.  Flip to True when
# you specifically want to exercise the limiter — the rules below are the same
# ones production runs, so the behaviour you see is the behaviour you ship.
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=10
# False, and the compose overlay pins it False too: nothing proxies for you
# locally, so X-Forwarded-For is whatever the caller typed.  Believing it would
# let a curl one-liner pick its own rate-limit bucket.
RATE_LIMIT_TRUST_PROXY=False
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json
RATE_LIMIT_RULES=POST /api/v1/users/login=5/60,POST /api/v1/users/token=5/60,POST /api/v1/users/register=5/60,POST /api/v1/users/refresh-token=5/60,POST /api/v1/users/change-password=5/60,/api/v1/uploads=5/60,POST /api/v1/newsletter/subscribe=5/300,POST /api/v1/newsletter/confirm=10/300,POST /api/v1/newsletter/unsubscribe=10/300

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origins the API accepts credentialed browser requests from.  The site itself
# never needs these — every browser-side call goes to a Next BFF route on the
# same origin.  They are here for hitting :8000 straight from a page served on
# :3000, which is the one thing that is cross-origin locally.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# How the Next server reaches the API.  A private Docker name is correct: this
# value never reaches a browser and is never used to build a media URL.
API_INTERNAL_ORIGIN=http://backend:8000

# The origin you actually open in the browser.  In production this is the
# public domain the host nginx serves; locally it is the Next server itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empty = media served same-origin.  Locally that is the /media rewrite in
# next.config.js; in production the host nginx answers it.  Set only for a CDN.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Lets the backend call POST /api/revalidate directly.  Any non-empty string
# works locally; the endpoint fails closed if it is unset.
REVALIDATION_SECRET=dev-only-revalidation-secret

# ── Newsletter ────────────────────────────────────────────────────────────────
# On locally, with no mail server: DEBUG lets the mailer log messages instead of
# sending them, so the whole double opt-in flow is walkable from the backend
# logs — `make logs` and copy the confirmation URL out of the message body.
# Point SMTP_HOST at a local catcher (MailHog on 1025, say) to see real mail.
NEWSLETTER_ENABLED=True
NEWSLETTER_FROM_EMAIL=newsletter@localhost
NEWSLETTER_FROM_NAME=Celeb Scoop
NEWSLETTER_REPLY_TO=
NEWSLETTER_CONFIRM_TOKEN_TTL_HOURS=48
# Short, so you are not locked out of retrying a signup while testing.
NEWSLETTER_RESEND_INTERVAL_SECONDS=30
NEWSLETTER_UNSUBSCRIBE_MAILBOX=
NEWSLETTER_TOKEN_SECRET=dev-only-newsletter-token-secret

# The public brand and origin, used to build links inside emails.  Must be an
# origin you can actually open, or the confirmation link in the log is dead.
SITE_NAME=Celeb Scoop
SITE_BASE_URL=http://localhost:3000
POSTAL_ADDRESS=1 Example Street, London, EC1A 1AA

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Empty = the console mailer above. A local catcher usually wants
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USE_TLS=False.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=10

# Renders the signup form. Inlined into the client bundle at build time, so it
# needs a rebuild when changed — and it must agree with NEWSLETTER_ENABLED
# above, or the form is either missing or posting at a backend that refuses it.
NEXT_PUBLIC_NEWSLETTER_ENABLED=true

# ── Google Integrations (SEO, Analytics & Ads) ─────────────────────────────────
# Google Search Console site verification meta tag content string
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense Publisher Client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

